  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "context7",
    "github",
    "ssh",
    "homelab",
    "ml-tools",
    "ppm"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude/hooks-rs/target/release/claude-hooks pre-edit",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude/hooks-rs/target/release/claude-hooks pre-bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude/hooks-rs/target/release/claude-hooks jax-shape-check",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$HOME/.local/share/claude-format-hook/format-code.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.dotfiles/claude/hooks-rs/target/release/claude-hooks user-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [],
    "SubagentStop": [],
    "SessionStart": []
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
